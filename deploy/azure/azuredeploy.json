{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "6376425294669778115"
    },
    "description": "Aurex: P2P money, AI hub and AI trading on one Azure VM with HTTPS, backups and Key Vault"
  },
  "parameters": {
    "adminEmail": {
      "type": "string",
      "metadata": {
        "description": "Your email. It becomes the admin account (sign up with it after setup) and gets HTTPS certificate notices."
      }
    },
    "domainName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional: your own domain, e.g. aurex.example.com. Leave empty to use the free address <name>.<region>.cloudapp.azure.com. For your own domain, add a DNS A record pointing at the public IP shown after deployment."
      }
    },
    "dnsLabel": {
      "type": "string",
      "defaultValue": "[format('aurex-{0}', uniqueString(resourceGroup().id))]",
      "minLength": 3,
      "maxLength": 63,
      "metadata": {
        "description": "Name for the free address <name>.<region>.cloudapp.azure.com (lowercase letters, digits and hyphens)."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2ats_v2",
      "allowedValues": [
        "Standard_B2ats_v2",
        "Standard_B2pts_v2",
        "Standard_B1s",
        "Standard_B2als_v2",
        "Standard_B2pls_v2",
        "Standard_B2s"
      ],
      "metadata": {
        "description": "Server size. B2ats_v2 (AMD), B2pts_v2 (Arm) and B1s include 750 free hours a month for the first 12 months of a new Azure account; they have 1 GiB of memory. B2als_v2 and B2pls_v2 have 4 GiB and are paid."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "aurexadmin",
      "metadata": {
        "description": "Login name for the server. You rarely need it: Run command and Serial console in the portal work without SSH."
      }
    },
    "authenticationType": {
      "type": "string",
      "defaultValue": "password",
      "allowedValues": [
        "password",
        "sshPublicKey"
      ],
      "metadata": {
        "description": "How you sign in to the server in an emergency (Serial console or SSH)."
      }
    },
    "adminPasswordOrKey": {
      "type": "securestring",
      "minLength": 12,
      "metadata": {
        "description": "A password (12+ characters with upper and lower case letters, a digit and a symbol) or an SSH public key."
      }
    },
    "sshSourceCidr": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional: an IP range allowed to SSH in, e.g. 203.0.113.4/32. Leave empty to keep SSH closed."
      }
    },
    "paymentRails": {
      "type": "string",
      "defaultValue": "sandbox",
      "metadata": {
        "description": "Payment methods to enable. \"sandbox\" uses test money; add real providers later in /opt/aurex/src/deploy/server/.env."
      }
    },
    "repositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/pizzatechies/P2P.git",
      "metadata": {
        "description": "Git repository to install from."
      }
    },
    "branch": {
      "type": "string",
      "defaultValue": "claude/gifted-ritchie-8xzdk9",
      "metadata": {
        "description": "Branch to install."
      }
    },
    "osDiskSizeGB": {
      "type": "int",
      "defaultValue": 64,
      "minValue": 30,
      "maxValue": 1024,
      "metadata": {
        "description": "Disk size in GB. A 64 GB Premium SSD (P6) is part of the free services for 12 months."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for every resource. Defaults to the resource group's region."
      }
    }
  },
  "variables": {
    "$fxv#0": "#!/bin/bash\n# First-boot script for the Aurex VM. main.bicep fills in the placeholders in double braces and passes this file as the\n# VM's customData. It clones Aurex and runs the shared installer. Progress: /var/log/aurex-install.log\nset -euo pipefail\nexec > >(tee -a /var/log/aurex-install.log) 2>&1\necho \"Aurex setup started $(date -u)\"\n\nexport DEBIAN_FRONTEND=noninteractive\napt-get -o DPkg::Lock::Timeout=600 update -y\napt-get -o DPkg::Lock::Timeout=600 install -y git\n\nmkdir -p /opt/aurex\nfor attempt in 1 2 3 4 5; do\n  [ -d /opt/aurex/src/.git ] && break\n  rm -rf /opt/aurex/src\n  git clone --depth 1 --branch '{{BRANCH}}' '{{REPOSITORY_URL}}' /opt/aurex/src || sleep $((attempt * 15))\ndone\n[ -d /opt/aurex/src/.git ] || { echo \"Couldn't clone {{REPOSITORY_URL}}\"; exit 1; }\n\ncd /opt/aurex/src\nADMIN_EMAIL='{{ADMIN_EMAIL}}' \\\nDOMAIN='{{DOMAIN}}' \\\nPAYMENT_RAILS='{{PAYMENT_RAILS}}' \\\nKEY_VAULT='{{KEY_VAULT}}' \\\nAZURE_STORAGE_ACCOUNT='{{STORAGE_ACCOUNT}}' \\\nAZURE_STORAGE_CONTAINER='{{STORAGE_CONTAINER}}' \\\n  ./deploy/server/install.sh\n\necho \"Aurex setup finished $(date -u)\"\n",
    "suffix": "[uniqueString(resourceGroup().id)]",
    "isArm": "[contains(createArray('Standard_B2pts_v2', 'Standard_B2pls_v2'), parameters('vmSize'))]",
    "keyVaultName": "[format('aurex-{0}', variables('suffix'))]",
    "storageAccountName": "[format('aurex{0}', variables('suffix'))]",
    "backupContainerName": "backups",
    "sshOpen": "[not(empty(parameters('sshSourceCidr')))]",
    "keyVaultSecretsOfficer": "b86a8fe4-44ce-4948-aee5-eccb2c155cd7",
    "keyVaultSecretsUser": "4633458b-17de-408a-b874-0445c86b69e6",
    "webRules": [
      {
        "name": "web",
        "properties": {
          "description": "HTTP (redirects to HTTPS and proves the domain for certificates) and HTTPS",
          "priority": 100,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Tcp",
          "sourceAddressPrefix": "Internet",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRanges": [
            "80",
            "443"
          ]
        }
      },
      {
        "name": "http3",
        "properties": {
          "description": "HTTP/3",
          "priority": 110,
          "direction": "Inbound",
          "access": "Allow",
          "protocol": "Udp",
          "sourceAddressPrefix": "Internet",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "443"
        }
      }
    ],
    "sshRules": "[if(variables('sshOpen'), createArray(createObject('name', 'ssh', 'properties', createObject('description', 'SSH from your IP range only', 'priority', 120, 'direction', 'Inbound', 'access', 'Allow', 'protocol', 'Tcp', 'sourceAddressPrefix', parameters('sshSourceCidr'), 'sourcePortRange', '*', 'destinationAddressPrefix', '*', 'destinationPortRange', '22'))), createArray())]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2025-05-01",
      "name": "aurex-nsg",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": "[concat(variables('webRules'), variables('sshRules'))]"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2025-05-01",
      "name": "aurex-vnet",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.20.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "default",
            "properties": {
              "addressPrefix": "10.20.1.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'aurex-nsg')]"
              },
              "serviceEndpoints": [
                {
                  "service": "Microsoft.Storage"
                }
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'aurex-nsg')]"
      ]
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2025-05-01",
      "name": "aurex-ip",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4",
        "dnsSettings": {
          "domainNameLabel": "[parameters('dnsLabel')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2025-05-01",
      "name": "aurex-nic",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'aurex-vnet', 'default')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip')]",
        "[resourceId('Microsoft.Network/virtualNetworks', 'aurex-vnet')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-06-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "allowCrossTenantReplication": false,
        "allowSharedKeyAccess": true,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Deny",
          "bypass": "AzureServices",
          "virtualNetworkRules": [
            {
              "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'aurex-vnet', 'default')]",
              "action": "Allow"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', 'aurex-vnet')]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        },
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('backupContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2025-05-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2025-05-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'STORAGE-KEY')]",
      "properties": {
        "contentType": "[format('Access key for storage account {0} (database backups)', variables('storageAccountName'))]",
        "value": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2025-06-01').keys[0].value]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2025-04-01",
      "name": "aurex-vm",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "aurex",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[if(equals(parameters('authenticationType'), 'password'), parameters('adminPasswordOrKey'), null())]",
          "customData": "[base64(string(reduce(items(createObject('ADMIN_EMAIL', parameters('adminEmail'), 'DOMAIN', if(empty(parameters('domainName')), reference(resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip'), '2025-05-01').dnsSettings.fqdn, parameters('domainName')), 'PAYMENT_RAILS', parameters('paymentRails'), 'KEY_VAULT', variables('keyVaultName'), 'STORAGE_ACCOUNT', variables('storageAccountName'), 'STORAGE_CONTAINER', variables('backupContainerName'), 'REPOSITORY_URL', parameters('repositoryUrl'), 'BRANCH', parameters('branch'))), variables('$fxv#0'), lambda('script', 'item', replace(string(lambdaVariables('script')), format('{{{{{0}}}}}', lambdaVariables('item').key), replace(lambdaVariables('item').value, '''', ''))))))]",
          "linuxConfiguration": "[if(equals(parameters('authenticationType'), 'password'), createObject('disablePasswordAuthentication', false(), 'provisionVMAgent', true()), createObject('disablePasswordAuthentication', true(), 'provisionVMAgent', true(), 'ssh', createObject('publicKeys', createArray(createObject('path', format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername')), 'keyData', parameters('adminPasswordOrKey'))))))]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "[if(variables('isArm'), 'server-arm64', 'server')]",
            "version": "latest"
          },
          "osDisk": {
            "name": "aurex-disk",
            "createOption": "FromImage",
            "diskSizeGB": "[parameters('osDiskSizeGB')]",
            "managedDisk": {
              "storageAccountType": "Premium_LRS"
            },
            "deleteOption": "Delete"
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'aurex-nic')]",
              "properties": {
                "deleteOption": "Detach"
              }
            }
          ]
        },
        "securityProfile": "[if(variables('isArm'), null(), createObject('securityType', 'TrustedLaunch', 'uefiSettings', createObject('secureBootEnabled', true(), 'vTpmEnabled', true())))]",
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', variables('backupContainerName'))]",
        "[resourceId('Microsoft.Network/networkInterfaces', 'aurex-nic')]",
        "[resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'STORAGE-KEY')]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.Compute/virtualMachines', 'aurex-vm'), variables('keyVaultSecretsOfficer'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsOfficer'))]",
        "principalId": "[reference(resourceId('Microsoft.Compute/virtualMachines', 'aurex-vm'), '2025-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Compute/virtualMachines', 'aurex-vm')]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), deployer().objectId, variables('keyVaultSecretsUser'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUser'))]",
        "principalId": "[deployer().objectId]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "Your Aurex address. It goes live about 10-20 minutes after the deployment finishes (first build)."
      },
      "value": "[format('https://{0}', if(empty(parameters('domainName')), reference(resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip'), '2025-05-01').dnsSettings.fqdn, parameters('domainName')))]"
    },
    "publicIp": {
      "type": "string",
      "metadata": {
        "description": "The server's fixed public IP. Point your domain's A record here."
      },
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip'), '2025-05-01').ipAddress]"
    },
    "azureAddress": {
      "type": "string",
      "metadata": {
        "description": "The free Azure address of this server."
      },
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip'), '2025-05-01').dnsSettings.fqdn]"
    },
    "adminSetupCode": {
      "type": "string",
      "metadata": {
        "description": "Where to find the admin setup code."
      },
      "value": "[format('Key Vault {0} > Objects > Secrets > ADMIN-SETUP-CODE', variables('keyVaultName'))]"
    },
    "backups": {
      "type": "string",
      "metadata": {
        "description": "Where the database backups go."
      },
      "value": "[format('Storage account {0}, container {1}, folder aurex', variables('storageAccountName'), variables('backupContainerName'))]"
    },
    "setupProgress": {
      "type": "string",
      "metadata": {
        "description": "How to watch the setup, without SSH."
      },
      "value": "Virtual machine aurex-vm > Operations > Run command > RunShellScript: tail -n 40 /var/log/aurex-install.log"
    },
    "ssh": {
      "type": "string",
      "metadata": {
        "description": "SSH command (only if you allowed an IP range)."
      },
      "value": "[if(variables('sshOpen'), format('ssh {0}@{1}', parameters('adminUsername'), reference(resourceId('Microsoft.Network/publicIPAddresses', 'aurex-ip'), '2025-05-01').ipAddress), 'SSH is closed. Use Run command or Serial console in the portal.')]"
    }
  }
}