{
  "name": "@aurex/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:app": "tsc --noEmit && vite build --mode app",
    "cap:sync": "npm run build:app && cap sync",
    "build:site": "vite build --mode site && SITE_PRERENDER=1 vite build --mode site && node scripts/finalize-site.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@smileid/web-sdk": "12.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  }
}
