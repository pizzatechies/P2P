# ---------------------------------------------------------------------------
# Aurex configuration. Copy to server/.env (or export in your shell / platform).
# Every variable is optional in development; see README "Going to production".
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./data/aurex.db
# Public URL of the web app (Stripe redirects, links). In production: https://your-domain
APP_URL=http://localhost:5173
# Encrypts stored API keys and 2FA secrets. REQUIRED in production: openssl rand -hex 32
MASTER_KEY=
SESSION_TTL_HOURS=168
# Comma-separated emails that get admin rights when they register or next sign in
ADMIN_EMAILS=
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ---- Payments --------------------------------------------------------------
# Comma-separated. sandbox = simulated test money; stripe = card deposits via Stripe Checkout;
# flutterwave = cards, bank transfers and mobile money across Africa; mpesa, mtn-momo, paypal, wise (see below)
PAYMENT_RAILS=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutterwave: secret key from the dashboard (Settings > API keys). Set the webhook URL to
# https://your-domain/api/webhooks/flutterwave and copy its "secret hash" here.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# M-Pesa direct (Safaricom Daraja), rail id "mpesa". Callbacks go to a secret URL derived from MASTER_KEY,
# so no webhook settings are needed. sandbox or production:
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Deposits (STK Push): your paybill/till store number and its Lipa Na M-Pesa passkey
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till); MPESA_PARTY_B = till number if different
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Payouts (B2C): B2C shortcode, API initiator and its SecurityCredential (generate it in the Daraja portal)
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# MTN MoMo direct, rail id "mtn-momo". One market per server.
MTN_MOMO_ENV=sandbox
# sandbox, or the market: mtnzambia, mtnuganda, mtnghana, mtncameroon, mtnivorycoast, mtnbenin, mtncongo, ...
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# That market's currency (the sandbox only accepts EUR)
MTN_MOMO_CURRENCY=EUR
# Collections (deposits) and Disbursements (payouts) are separate products with separate keys
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_USER_ID=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_USER_ID=
MTN_MOMO_DISBURSEMENT_API_KEY=

# PayPal & Venmo, rail id "paypal". Webhook (optional, speeds things up): https://your-domain/api/webhooks/paypal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Wise payouts to 160+ countries, rail id "wise". A token and the business profile that funds payouts.
WISE_ENV=sandbox
WISE_API_TOKEN=
WISE_PROFILE_ID=
# Balance used when the profile holds no balance in the payout currency (Wise converts)
WISE_FUNDING_CURRENCY=USD
# Fees in basis points (100 = 1%)
P2P_FEE_BPS=0
FX_SPREAD_BPS=50
WITHDRAWAL_FEE_BPS=0
# Risk limits in USD-equivalent
MAX_TX_USD=10000
DAILY_LIMIT_USD=25000
# Use live exchange rates instead of the built-in indicative table
FX_LIVE=false
FX_RATES_URL=https://open.er-api.com/v6/latest/USD

# ---- AI providers (server-wide keys; users can also add their own) ------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
# e.g. http://localhost:11434
OLLAMA_BASE_URL=
# Free AI allowance: requests per user per day on the server's keys above (0 = unlimited).
# Users' own keys are never limited.
AI_FREE_DAILY_REQUESTS=25
# Optional: only these models may use the server's keys, e.g. anthropic:claude-haiku-5-5,openai:gpt-5-mini
AI_FREE_MODELS=
# Default model for the trading analyst, as provider:model (e.g. anthropic:claude-opus-5-5)
AI_DEFAULT_MODEL=

# ---- Trading -----------------------------------------------------------------
# Server-wide Alpaca keys for real market data (users can connect their own accounts too)
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
# Must be true before anyone can connect a LIVE (real-money) Alpaca account
ALLOW_LIVE_TRADING=false
PAPER_STARTING_CASH=100000
# Max share of portfolio value one AI-suggested buy may use (0.1 = 10%)
AI_MAX_POSITION_PCT=0.1
# AI Autopilot: lets users have the AI trade for them within their own limits
AUTOPILOT_ENABLED=true
# Must be true (with ALLOW_LIVE_TRADING) before the autopilot may trade real-money accounts
ALLOW_LIVE_AUTOPILOT=false
# Shortest interval users may choose between autopilot checks
AUTOPILOT_MIN_INTERVAL_MIN=5

# ---- Connections (read-only links to outside banks, brokerages and wallets) ----
# Each aggregator is optional; its card appears as "Connect" once its keys are set.
# Plaid: US, Canada, UK and Europe banks. Webhook: https://your-domain/api/webhooks/plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,CA,GB,IE,FR,ES,NL,DE
# Salt Edge (Account Information API v6): banks in Europe, Middle East, Asia, Latin America, Africa
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
# Mono: Nigerian and other African banks. Webhook: https://your-domain/api/webhooks/mono
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
# SnapTrade: retail brokerages (Schwab, Fidelity, Robinhood, IBKR, ...)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Coinbase (read-only crypto balances). OAuth app redirect URI: https://your-domain/api/connections/oauth/coinbase/callback
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
