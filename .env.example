# ---------------------------------------------------------------------------
# Aurex configuration. Copy to server/.env (or export in your shell / platform).
# Every variable is optional in development; see README "Going to production".
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./data/aurex.db
# Public URL of the web app (Stripe redirects, links). In production: https://your-domain
APP_URL=http://localhost:5173
# Encrypts stored API keys and 2FA secrets. REQUIRED in production: openssl rand -hex 32
MASTER_KEY=
SESSION_TTL_HOURS=168
# Comma-separated emails that get admin rights when they register or next sign in
ADMIN_EMAILS=
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ---- Payments --------------------------------------------------------------
# sandbox = simulated test money; stripe = real card deposits via Stripe Checkout
PAYMENT_RAILS=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fees in basis points (100 = 1%)
P2P_FEE_BPS=0
FX_SPREAD_BPS=50
WITHDRAWAL_FEE_BPS=0
# Risk limits in USD-equivalent
MAX_TX_USD=10000
DAILY_LIMIT_USD=25000
# Use live exchange rates instead of the built-in indicative table
FX_LIVE=false
FX_RATES_URL=https://open.er-api.com/v6/latest/USD

# ---- AI providers (server-wide keys; users can also add their own) ------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
# e.g. http://localhost:11434
OLLAMA_BASE_URL=
# Default model for the trading analyst, as provider:model (e.g. anthropic:claude-opus-5-5)
AI_DEFAULT_MODEL=

# ---- Trading -----------------------------------------------------------------
# Server-wide Alpaca keys for real market data (users can connect their own accounts too)
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
# Must be true before anyone can connect a LIVE (real-money) Alpaca account
ALLOW_LIVE_TRADING=false
PAPER_STARTING_CASH=100000
# Max share of portfolio value one AI-suggested buy may use (0.1 = 10%)
AI_MAX_POSITION_PCT=0.1
