# ---------------------------------------------------------------------------
# Aurex configuration. Copy to server/.env (or export in your shell / platform).
# Every variable is optional in development; see README "Going to production".
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./data/aurex.db
# Public URL of the web app (Stripe redirects, links). In production: https://your-domain
APP_URL=http://localhost:5173
# Encrypts stored API keys and 2FA secrets. REQUIRED in production: openssl rand -hex 32
MASTER_KEY=
SESSION_TTL_HOURS=72
# Sign out after this many idle minutes (0 = never)
SESSION_IDLE_MINUTES=120
# Accounts allowed to become admin. In production they must ALSO enter ADMIN_SETUP_CODE
# (Settings -> Admin access, with 2FA on): an email address alone is never trusted.
ADMIN_EMAILS=
# openssl rand -hex 16. The deploy scripts generate one and print it once.
ADMIN_SETUP_CODE=
# Admin tools require two-factor authentication
REQUIRE_ADMIN_2FA=true
# Admin tools only from these addresses or CIDR ranges (comma-separated; empty = anywhere)
ADMIN_ALLOWED_IPS=
# Admins are signed out after this many idle minutes (everyone else: SESSION_IDLE_MINUTES)
ADMIN_SESSION_IDLE_MINUTES=30
# Extra origins allowed to make state-changing requests besides APP_URL (comma-separated)
ALLOWED_ORIGINS=
# When rotating MASTER_KEY: put the old value(s) here; secrets are re-encrypted at startup
MASTER_KEY_PREVIOUS=
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ---- Email (verification codes and security alerts) --------------------------
# Resend API key. Without it, development shows codes in the app; production sends nothing and
# leaves verification off (with a startup warning).
RESEND_API_KEY=
# A sender on a domain you've verified with Resend
EMAIL_FROM=Aurex <no-reply@yourdomain.com>
# Require a verified email for withdrawals, pay-by-email, admin and real accounts (default: on when email works)
REQUIRE_EMAIL_VERIFICATION=

# ---- Real trading accounts (upgrade from demo) -------------------------------
# Approve upgrade applications automatically instead of waiting for an admin
LIVE_UPGRADE_AUTO_APPROVE=false
# Countries where real accounts may be opened, e.g. US,GB,KE (empty = any)
LIVE_COUNTRIES=
# Demo trades needed before applying
LIVE_MIN_PRACTICE_TRADES=3

# ---- Account protection ------------------------------------------------------
# Failed sign-ins (password or 2FA) before a lock; first lock length doubles each time (max 24h)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12
# Refuse passwords from known breaches (Have I Been Pwned; only 5 hash characters are sent). Default on.
PASSWORD_BREACH_CHECK=true
# A password/2FA re-check unlocks withdrawals and large sends for this long
REAUTH_WINDOW_MINUTES=10
# Sends to other users at or above this USD value need the re-check (0 = every send)
STEP_UP_SEND_USD=1000
# Withdrawals and large sends pause this long after a password change, 2FA removal or recovery-code sign-in
SECURITY_HOLD_HOURS=24

# ---- Payments --------------------------------------------------------------
# Comma-separated. sandbox = simulated test money; stripe = card deposits via Stripe Checkout;
# flutterwave = cards, bank transfers and mobile money across Africa; mpesa, mtn-momo, paypal, wise, skrill, moneygram (see below)
PAYMENT_RAILS=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutterwave: secret key from the dashboard (Settings > API keys). Set the webhook URL to
# https://your-domain/api/webhooks/flutterwave and copy its "secret hash" here.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# M-Pesa direct (Safaricom Daraja), rail id "mpesa". Callbacks go to a secret URL derived from MASTER_KEY,
# so no webhook settings are needed. sandbox or production:
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Deposits (STK Push): your paybill/till store number and its Lipa Na M-Pesa passkey
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till); MPESA_PARTY_B = till number if different
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Payouts (B2C): B2C shortcode, API initiator and its SecurityCredential (generate it in the Daraja portal)
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# MTN MoMo direct, rail id "mtn-momo". One market per server.
MTN_MOMO_ENV=sandbox
# sandbox, or the market: mtnzambia, mtnuganda, mtnghana, mtncameroon, mtnivorycoast, mtnbenin, mtncongo, ...
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# That market's currency (the sandbox only accepts EUR)
MTN_MOMO_CURRENCY=EUR
# Collections (deposits) and Disbursements (payouts) are separate products with separate keys
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_USER_ID=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_USER_ID=
MTN_MOMO_DISBURSEMENT_API_KEY=

# Airtel Money, rail id "airtel" (Airtel Africa Open API). One country per server.
# Callback URL to set in the Airtel portal: https://your-domain/api/webhooks/airtel
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# The merchant account's country and currency, e.g. KE/KES, UG/UGX, TZ/TZS, ZM/ZMW, RW/RWF, NG/NGN
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES
# Payouts (disbursements): your disbursement PIN, and Airtel's RSA public key from the portal (the
# base64 text on one line is fine). Without both, Airtel Money is deposits only.
AIRTEL_DISBURSEMENT_PIN=
AIRTEL_PUBLIC_KEY=

# PayPal & Venmo, rail id "paypal". Webhook (optional, speeds things up): https://your-domain/api/webhooks/paypal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Wise payouts to 160+ countries, rail id "wise". A token and the business profile that funds payouts.
WISE_ENV=sandbox
WISE_API_TOKEN=
WISE_PROFILE_ID=
# Balance used when the profile holds no balance in the payout currency (Wise converts)
WISE_FUNDING_CURRENCY=USD
# Only accept M-Pesa callbacks from these IPs (Safaricom's published list), comma-separated
MPESA_CALLBACK_IPS=

# Skrill, rail id "skrill". Status URL is set automatically: https://your-domain/api/webhooks/skrill
# Merchant email and secret word (Settings > Developer Settings) for Quick Checkout deposits;
# the API/MQI password enables status checks and payouts to Skrill accounts (whitelist the server IP).
SKRILL_EMAIL=
SKRILL_SECRET_WORD=
SKRILL_API_PASSWORD=

# MoneyGram business disbursements (cash pickup in 200+ countries), rail id "moneygram"
MONEYGRAM_ENV=sandbox
MONEYGRAM_CLIENT_ID=
MONEYGRAM_CLIENT_SECRET=
MONEYGRAM_PARTNER_ID=
# Currencies your MoneyGram account settles in
MONEYGRAM_SEND_CURRENCIES=USD
# Fees in basis points (100 = 1%)
P2P_FEE_BPS=0
FX_SPREAD_BPS=50
WITHDRAWAL_FEE_BPS=0
# Kept from each payment an approved business account receives (150 = 1.5%); the payer pays nothing extra
MERCHANT_FEE_BPS=0
# Risk limits in USD-equivalent
MAX_TX_USD=10000
DAILY_LIMIT_USD=25000
# Limits by identity verification level (USD-equivalent). Level 2 (Enhanced) uses
# MAX_TX_USD / DAILY_LIMIT_USD above. Set KYC_LIMITS=false to give everyone those.
KYC_LIMITS=true
TIER0_TX_USD=200
TIER0_DAILY_USD=500
TIER1_TX_USD=2000
TIER1_DAILY_USD=5000
# Approve complete identity submissions without a person reviewing them (testing only)
KYC_AUTO_APPROVE=false
# Smile ID: check ID numbers against government records (Enhanced KYC). Callback URL to set in
# the Smile ID portal: https://your-domain/api/webhooks/smileid
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_ENV=sandbox
# Also compare the customer's selfie with the photo on their ID document (Smile ID SmartSelfie Compare,
# billed per check). With auto-approval on, both checks must then pass.
SMILEID_SELFIE_CHECK=false
# Approve identity level 1 automatically when the government record matches the name and birth date
SMILEID_AUTO_APPROVE=false
# Another admin must approve custom limits and hand-set identity levels: auto (when there's a
# second admin who could approve), on or off
TWO_PERSON_APPROVAL=auto
# Business days to give a final answer to a complaint
COMPLAINT_RESPONSE_DAYS=15
# Politically exposed person (PEP) screening with the OpenSanctions match API (prepaid credit bundles for
# business use, at opensanctions.org/api). Off while the key is empty.
OPENSANCTIONS_API_KEY=
# Match score from 0.5 to 1 at which a result counts as a possible match
PEP_THRESHOLD=0.8
# Check people again after this many days (0 = never), at most PEP_RESCREEN_BATCH per run (every 6 hours)
PEP_RESCREEN_DAYS=365
PEP_RESCREEN_BATCH=200
# Bot protection: a free Cloudflare Turnstile widget (dash.cloudflare.com -> Turnstile) on sign-up,
# sign-in, password reset and the waitlist. Off while either is empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Legal pages (/terms, /privacy, /fees, /complaints, /risk). The texts are docs/go-live/legal; these
# fill their placeholders. Set LEGAL_FINAL=true once a lawyer has approved them (removes the draft notice).
LEGAL_COMPANY_NAME=
LEGAL_REGISTRATION_NUMBER=
LEGAL_ADDRESS=
LEGAL_COUNTRY=
LEGAL_EFFECTIVE_DATE=
LEGAL_FINAL=false
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Defaults to SUPPORT_EMAIL
COMPLAINTS_EMAIL=
DPO_NAME=
DPO_EMAIL=
# Aurex Pro: a monthly plan paid from the customer's wallet (bigger AI allowance, Autopilot, more Web3 wallets)
PRO_ENABLED=false
PRO_PRICE=4.99
PRO_CURRENCY=USD
PRO_AI_DAILY_REQUESTS=200
FREE_WEB3_WALLETS=3
# Who can sign up: open, invite (invite codes; others join a waitlist) or closed. ADMIN_EMAILS always can.
REGISTRATION_MODE=open
# Most customer accounts allowed (0 = no cap); more sign-ups join the waitlist
MAX_USERS=0
# Sanctions screening against the UN and OFAC lists (downloaded from the official sources daily)
SANCTIONS_SCREENING=true
# SANCTIONS_UN_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
# SANCTIONS_OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.csv
# SANCTIONS_OFAC_ALT_URL=https://www.treasury.gov/ofac/downloads/alt.csv
# Real money: withdrawals at or over PAYOUT_REVIEW_USD (or from a customer with an open
# monitoring alert) wait for a second admin before they're sent
PAYOUT_REVIEW=true
PAYOUT_REVIEW_USD=1000
# Transaction monitoring flags single payments at or over this (USD-equivalent)
MONITOR_LARGE_USD=3000
# A safeguarding account balance older than this no longer counts as verified
SAFEGUARDING_STALE_HOURS=48
# Use live exchange rates instead of the built-in indicative table
FX_LIVE=false
FX_RATES_URL=https://open.er-api.com/v6/latest/USD

# ---- AI providers (server-wide keys; users can also add their own) ------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
# e.g. http://localhost:11434
OLLAMA_BASE_URL=
# Free AI allowance: requests per user per day on the server's keys above (0 = unlimited).
# Users' own keys are never limited.
AI_FREE_DAILY_REQUESTS=25
# Optional: only these models may use the server's keys, e.g. anthropic:claude-haiku-5-5,openai:gpt-5-mini
AI_FREE_MODELS=
# Default model for the trading analyst, as provider:model (e.g. anthropic:claude-opus-5-5)
AI_DEFAULT_MODEL=

# ---- Trading -----------------------------------------------------------------
# Server-wide Alpaca keys for real market data (users can connect their own accounts too)
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
# Crypto prices: "coinbase" (live, from Coinbase's public market data; no key needed) or "simulated"
CRYPTO_DATA=coinbase
# US stock list for search: "nasdaq" (every listing, from Nasdaq Trader's daily files) or "builtin" (popular names)
STOCK_DIRECTORY=nasdaq
# Must be true before anyone can connect a LIVE (real-money) Alpaca account
ALLOW_LIVE_TRADING=false
PAPER_STARTING_CASH=100000
# Max share of portfolio value one AI-suggested buy may use (0.1 = 10%)
AI_MAX_POSITION_PCT=0.1
# AI Autopilot: lets users have the AI trade for them within their own limits
AUTOPILOT_ENABLED=true
# Must be true (with ALLOW_LIVE_TRADING) before the autopilot may trade real-money accounts
ALLOW_LIVE_AUTOPILOT=false
# Shortest interval users may choose between autopilot checks
AUTOPILOT_MIN_INTERVAL_MIN=5

# ---- Connections (read-only links to outside banks, brokerages and wallets) ----
# Each aggregator is optional; its card appears as "Connect" once its keys are set.
# Plaid: US, Canada, UK and Europe banks. Webhook: https://your-domain/api/webhooks/plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,CA,GB,IE,FR,ES,NL,DE
# Salt Edge (Account Information API v6): banks in Europe, Middle East, Asia, Latin America, Africa
SALTEDGE_APP_ID=
SALTEDGE_SECRET=
# Mono: Nigerian and other African banks. Webhook: https://your-domain/api/webhooks/mono
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
# SnapTrade: retail brokerages (Schwab, Fidelity, Robinhood, IBKR, ...)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Coinbase (read-only crypto balances). OAuth app redirect URI: https://your-domain/api/connections/oauth/coinbase/callback
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
# Web3 wallets (watch-only, by public address). Free public endpoints by default; for heavier use,
# point these at your own node or a provider (Alchemy, Infura, QuickNode, Helius...).
WEB3_WALLETS=true
# WEB3_ETHEREUM_RPC=https://ethereum-rpc.publicnode.com
# WEB3_BASE_RPC=https://base-rpc.publicnode.com
# WEB3_ARBITRUM_RPC=https://arbitrum-one-rpc.publicnode.com
# WEB3_OPTIMISM_RPC=https://optimism-rpc.publicnode.com
# WEB3_POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# WEB3_BNB_RPC=https://bsc-rpc.publicnode.com
# WEB3_SOLANA_RPC=https://api.mainnet-beta.solana.com
# WEB3_BITCOIN_API=https://blockstream.info/api
